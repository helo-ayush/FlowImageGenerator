# Google Flow URL (default: https://flow.google)
FLOW_URL=https://flow.google

# Path to the exported Playwright session state JSON
STORAGE_STATE_PATH=storage_state.json

# API Bearer Token for securing endpoints (Required for production / Spaces)
API_BEARER_TOKEN=your_secure_bearer_token_here

# Optional: Base64-encoded storage state for cloud containers
# SESSION_STORAGE_BASE64=

# Webshare Proxy Configuration (Static/Dedicated IPs - no 15-min expiration)
# Supports:
# 1. Single proxy URL: http://username:password@p.webshare.io:80
# 2. Direct static IP: http://username:password@185.x.x.x:port
# 3. Comma-separated 10 static IPs: http://user:pass@ip1:port,http://user:pass@ip2:port
# 4. Standard proxy export: 185.x.x.x:port:username:password
WEBSHARE_PROXY_URL=http://username:password@p.webshare.io:80

# Optional: Force a specific proxy index (0-9) from your Webshare IP list
# WEBSHARE_PROXY_INDEX=0

# Optional: Fallback Residential proxy
# RESIDENTIAL_PROXY_URL=

# Headless mode for engine.py (True or False)
HEADLESS=True

# Timeout in seconds for finding elements and rendering
TIMEOUT_SECONDS=30

# Maximum parallel browser sessions / concurrent prompt jobs (default: 2)
MAX_CONCURRENT_REQUESTS=2
