# =================================================================
# Security & Secret Exclusions (CRITICAL FOR HUGGING FACE SPACES)
# =================================================================
# Pre-authenticated session state tokens and Google cookies
storage_state.json
storage_state_*.json
*.session.json

# Persistent Chrome profile (contains live cookies, device tokens, localStorage)
chrome_profile/
chrome_profile*/

# Local environment variables and secrets
.env
.env.local
.env.*
!.env.example
backups/
hf_clone/

# =================================================================
# Generated Media & Runtime Artifacts
# =================================================================
outputs/
outputs/*
*.png
*.jpg
*.jpeg
*.webp
debug_error*.png
*.log

# Temporary storage directories
.tempmediaStorage/
.user_uploaded/
temp/
tmp/

# =================================================================
# Python Environment & Build Artifacts
# =================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =================================================================
# IDE & Operating System Artifacts
# =================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
